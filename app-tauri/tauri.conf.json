{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konzte Faceit",
  "mainBinaryName": "konzte",
  "version": "1.1.4",
  "identifier": "com.konzte.app",
  "build": { "frontendDist": "shell/stub" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "category": "Game",
    "shortDescription": "Konzte Faceit",
    "longDescription": "Konzte — ranked 5v5 and 2v2 matchmaking for Combat Master",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["English", "Ukrainian", "Russian"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "linux": { "appimage": { "bundleMediaFramework": true } }
  }
}
